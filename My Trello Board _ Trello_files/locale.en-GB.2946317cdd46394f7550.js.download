ter.the-other-change-couldnt-be-made":"The other change couldn't be made.","templates.ai_board_builder_command_center.try-again":"Try again","templates.ai_board_builder_command_center.unarchiving-a-card":"Unarchiving a card","templates.ai_board_builder_command_center.updating-a-board-label":"Updating a board label","templates.ai_board_builder_command_center.updating-a-card":"Updating a card","templates.ai_board_builder_command_center.updating-a-checklist":"Updating a checklist","templates.ai_board_builder_command_center.updating-a-list":"Updating a list","templates.ai_board_builder_command_center.updating-board-details":"Updating board details","templates.ai_board_builder_command_center.what-specifically-would-you-like-to-change":"What specifically would you like to change?","templates.ai_board_builder_command_center.what-would-you-like-to-change":"What would you like to change...","templates.ai_board_builder_command_center.your-changes-to-the-board-have-been-made":"Your changes to the board have been made.","templates.ai_disclaimer.uses-ai-verify-results":"Uses AI. Verify results.","templates.ai_image_generation.add-a-style-to-your-image":"Add a style to your image","templates.ai_image_generation.background-generated-with-ai":"Background generated with AI","templates.ai_image_generation.background-has-been-generated-with-ai":"The background has been generated with AI","templates.ai_image_generation.close-generate-with-ai":"Close the generate with AI screen","templates.ai_image_generation.cover-generated-with-ai":"Cover generated with AI","templates.ai_image_generation.cover-has-been-generated-with-ai":"The cover has been generated with AI","templates.ai_image_generation.create-background-image":"Create a background image","templates.ai_image_generation.create-cover-image":"Create a cover image","templates.ai_image_generation.discovery-spotlight-board-background-body":"Customize your boards with the perfect image using AI to turn your vision into reality.","templates.ai_image_generation.discovery-spotlight-board-background-heading":"Generate backgrounds with AI","templates.ai_image_generation.discovery-spotlight-card-cover-body":"Customize your cards with the perfect image using AI to turn your vision into reality.","templates.ai_image_generation.discovery-spotlight-card-cover-heading":"Generate card covers with AI","templates.ai_image_generation.discovery-spotlight-dismiss":"Dismiss","templates.ai_image_generation.error-generating-background-with-ai":"Error generating background with AI","templates.ai_image_generation.error-generating-cover-with-ai":"Error generating cover with AI","templates.ai_image_generation.failed-to-generate-background-with-ai":"Failed to generate background with AI","templates.ai_image_generation.failed-to-generate-cover-with-ai":"Failed to generate cover with AI","templates.ai_image_generation.generate-image":"Generate image","templates.ai_image_generation.generate-with-ai":"Generate with AI","templates.ai_image_generation.generated-background":"Generated background","templates.ai_image_generation.generated-cover":"Generated cover","templates.ai_image_generation.generated-cover-is-missing-image-data":"Generated cover is missing image data","templates.ai_image_generation.generating-your-image":"Generating your image...","templates.ai_image_generation.image-credits-available":"{availableUsageLimit} of {usageLimit} image credits available","templates.ai_image_generation.new":"New","templates.ai_image_generation.no-image-returned-from-generation":"AI couldn’t generate an image from that prompt. Try adding more detail so the AI knows what to create","templates.ai_image_generation.out-of-image-credits-tooltip":"You're out of image credits.","templates.ai_image_generation.prompt-placeholder":"An image with a nice sunrise...","templates.ai_image_generation.resets-on-date":"Resets on {resetDate}","templates.ai_image_generation.style-abstract":"Abstract","templates.ai_image_generation.style-drawing":"Drawing","templates.ai_image_generation.style-graphic-design":"Graphic design","templates.ai_image_generation.style-landscape":"Landscape","templates.ai_image_generation.style-none":"None","templates.ai_image_generation.style-realistic":"Realistic","templates.ai_image_generation.style-vintage":"Vintage","templates.ai_image_generation.style-watercolors":"Watercolors","templates.ai_image_generation.submit-what-you-want-to-generate":"Submit what you want to generate","templates.ai_image_generation.tip-1":'Add details like "close-up" or "wide angle" to control the framing of your image.',"templates.ai_image_generation.tip-10":'Mention the time of day like "early morning" or "late evening" to shift the light and mood.',"templates.ai_image_generation.tip-11":'Use depth-of-field cues like "blurred background" or "sharp focus throughout" to direct the eye.',"templates.ai_image_generation.tip-12":'Say where the subject sits — "centered," "off to the left," or "rule of thirds" — to control composition.',"templates.ai_image_generation.tip-13":'Describe the weather — "misty," "stormy skies," or "bright and clear" — to add atmosphere.',"templates.ai_image_generation.tip-14":'Name a single focal subject like "one red bicycle" so the image doesn\'t get crowded.',"templates.ai_image_generation.tip-15":'Borrow a genre look like "sci-fi," "fantasy," or "noir" to bundle a whole mood into one word.',"templates.ai_image_generation.tip-2":'Mention lighting — "golden hour," "neon glow," or "soft shadows" — to set the mood.',"templates.ai_image_generation.tip-3":'Describe the setting or background — "on a mountain," "in a cozy caf\xe9" — to add context.',"templates.ai_image_generation.tip-4":'Specify a color palette like "pastel tones" or "bold primary colors" to guide the look.',"templates.ai_image_generation.tip-5":'Try adding "detailed" or "minimalist" to control how busy the image feels.',"templates.ai_image_generation.tip-6":'Reference an era or aesthetic like "1980s retro" or "mid-century modern" to anchor the vibe.',"templates.ai_image_generation.tip-7":'Set the emotional tone with words like "calm," "energetic," or "playful" to shape how the image feels.',"templates.ai_image_generation.tip-8":'Choose a camera angle — "bird\'s-eye view," "low angle," or "eye level" — to change the viewer\'s perspective.',"templates.ai_image_generation.tip-9":'Add a season — "spring blossoms," "autumn leaves," or "fresh snow" — to set the scene in time.',"templates.ai_image_generation.tip-label":"Tip","templates.ai_image_generation.unable-to-generate-image-due-to-unsupported-content":"Unable to generate image due to unsupported content. Please edit your prompt and try again.","templates.ai_image_generation.unknown-error":"Unknown error","templates.ai_image_generation.use-image":"Use image","templates.alerts.ai-activated-email-to-inbox-error":"We couldn't activate AI for Email to Inbox; refresh and try again","templates.alerts.ai-activated-for-e2b-error":"We couldn't activate AI for Email to Board; refresh and try again","templates.alerts.ai-deactivated-email-to-inbox-error":"We couldn't deactivate AI for Email to Inbox; refresh and try again","templates.alerts.ai-deactivated-for-e2b-error":"We couldn't deactivate AI for Email to Board; refresh and try again","templates.alerts.ai-e2b-description":"AI will summarize, create checklists, and format cards created from email.","templates.alerts.changes not saved":"Change not saved: failed to sync with the Trello server.","templates.alerts.changes-saved":"Changes saved","templates.alerts.copied-to-clipboard":"Copied to clipboard","templates.alerts.could not add plugin":"Could not add Power-Up","templates.alerts.could not connect":"Could not connect to Trello.","templates.alerts.could not create board":"Unable to create board","templates.alerts.could not send email":"Could not send email - please try again later","templates.alerts.email sent":"Email sent","templates.alerts.file size exceeds 10mb":"File size exceeds 10MB limit","templates.alerts.file size exceeds 250mb":"File size exceeds 250MB limit","templates.alerts.file too large":"File too large","templates.alerts.filename finished uploading":"{attachmentName} finished uploading!","templates.alerts.invalid sort order returned":"Power-Up returned an invalid sort order","templates.alerts.list move failed":"Unable to move list","templates.alerts.plugin not allowed":"The enterprise that owns this board doesn't allow this Power-Up","templates.alerts.power-up-created":"Power-Up created \uD83C\uDF89","templates.alerts.power-up-deleted":"Power-Up deleted","templates.alerts.power-up-listing-deleted":"Power-Up listing deleted","templates.alerts.reload page":"Reload page","templates.alerts.retrying":"Connection interrupted. Retrying…","templates.alerts.sending":"Sending…","templates.alerts.something-went-wrong":"Something went wrong","templates.alerts.there is already a collection with that name":"There is already a collection with that name","templates.alerts.timed out":"Timed out while trying to sync changes with the server.","templates.alerts.unlicensed member cannot copy enterprise board":"This board is part of the {enterpriseName} Enterprise. To copy this board, you must be granted an Enterprise license by an admin of {enterpriseName}.","templates.alerts.uploading":"Uploading {attachmentName}… {percentString}","templates.alerts.uploading files":"Uploading files","templates.alerts.uploading files number of file numbers":"Uploading files {fileIdx} of {numOfFiles}... {percent}","templates.and":"and","templates.announcement.read-more-ellipsis":"Read more…","templates.announcements.maintenance":"Down for maintenance soon…","templates.announcements.new stuff":"New stuff!","templates.app_management.90-day-board-usage":"90 Day board usage","templates.app_management.acknowledge-terms":"I acknowledge that I have read and agree to the <a>Trello Developer Terms</a>.","templates.app_management.add":"Add","templates.app_management.add-collaborator-aria-label":"Add {fullName}","templates.app_management.add-collaborators":"Add collaborators","templates.app_management.add-oauth-2-0":"Add OAuth 2.0","templates.app_management.add-oauth-2-0-dialog-title":"Add an OAuth 2.0 client to your app?","templates.app_management.add-oauth-2-0-message":"Adding an OAuth 2.0 client will allow your app to access the Trello API.","templates.app_management.add-trello-auth":"Add Trello Auth","templates.app_management.admin":"Admin","templates.app_management.allowed-origin-example":"e.g. https://example.com","templates.app_management.allowed-origins":"Allowed origins","templates.app_management.allowed-origins-description":"You should specify the <a>origins</a> that your application is allowed to redirect back to following the authorization flow. Trello will prevent a redirect to any origin not specified here.","templates.app_management.api-key":"API key","templates.app_management.api-key-description":"If your Power-Up uses the Trello REST API, please provide your API key.","templates.app_management.api-key-information":"Public Power-Ups that store personal data are required to register the API key they use to access personal data.","templates.app_management.api-key-introduction":"Each Power-Up can now have a unique API key and be managed here by any collaborators.","templates.app_management.api-key-management-description":"Most developers will need to ask each user to <link1>authorize</link1> your application. If you are looking to build an application for yourself, or are doing local testing, you can manually generate a <link2>Token</link2>.","templates.app_management.app-key":"App key","templates.app_management.app-name":"App name","templates.app_management.app-secret-trello-supports-oauth":"Trello supports OAuth 1 <a>authorization</a>, if you would like to use this, you will need your Secret.","templates.app_management.app-specifications":"App specifications","templates.app_management.app-stores-personal-data":"Does your app store any Trello user personal data?","templates.app_management.app-stores-personal-data-information":"Apps that store personal data outside of Trello have extra requirements. <a>Learn more</a> about personal data storage requirements and best practices.","templates.app_management.apps-admin-page-title":"Apps administration","templates.app_management.attachment-sections":"Attachment sections","templates.app_management.attachment-sections-description":"An attachment section is an iframe that gets rendered on the back of a card, above the attachments section. You give the section a title and icon, and tell Trello what page to load into the iframe. That page is then responsible for rendering content relevant to any attached URLs that it has claimed.","templates.app_management.attachment-thumbnail":"Attachment thumbnail","templates.app_management.attachment-thumbnail-description":"This capability will allow your Power-Up to provide additional information about an attachment that doesn't require being pulled out into its own section.","templates.app_management.author":"Author","templates.app_management.author-description":"Your company name (or personal name if you're not associated with an organization).","templates.app_management.author-name-placeholder":"Author Name","templates.app_management.authorization":"Authorization","templates.app_management.authorization-status":"Authorization status","templates.app_management.authorization-status-description":"If your Power-Up requires that users authorize with some service before they can get the full functionality, you can help give them another way to authorize by telling Trello whether the user in question has already completed authorization with this capability.","templates.app_management.authorization-type":"Authorization type","templates.app_management.back":"Back","templates.app_management.basic-information":"Basic information","templates.app_management.better-way-to-manage-api-keys":"A better way to manage API keys","templates.app_management.board-buttons":"Board buttons","templates.app_management.board-buttons-description":"Board buttons enable developers to bring features of their Power-Up to the entire Board or to give users control over settings that affect the Power-Up as a whole.","templates.app_management.callback-url-placeholder":"e.g. https://example.com/callback","templates.app_management.callback-url-required-message":"At least one callback URL is required before your app can use OAuth 2.0.","templates.app_management.callback-urls-required":"Callback URL(s) (required)","templates.app_management.cancel":"Cancel","templates.app_management.capabilities":"Capabilities","templates.app_management.card-back-section":"Card back section","templates.app_management.card-back-section-description":"A card back section is an iframe that gets rendered on the back of a card, above the attachments section. You give the section a title and icon, and tell Trello what page to load into the iframe.","templates.app_management.card-badges":"Card badges","templates.app_management.card-badges-description":"Card badges are useful for showing quick, glanceable information on the front of cards. You can provide an icon, some text, as well as an optional color for each of your badges.","templates.app_management.card-buttons":"Card buttons","templates.app_management.card-buttons-description":"Sometimes you may want to allow users to take actions directly on and related to a specific card. In those cases you would use this capability to add the buttons you need to the card.","templates.app_management.card-detail-badges":"Card detail badges","templates.app_management.card-detail-badges-description":"This capability provides a way to show quick, glanceable information at the top of the back of the card. Like the badges on the front of the card, these can be colored, and dynamic.","templates.app_management.card-from-url":"Card from URL","templates.app_management.card-from-url-description":'Trello will create cards for you automatically when you drag and drop or <code>CTRL+C</code> / <code>CTRL+V</code> URLs onto the "Add a card..." area at the bottom of a list. Your Power-Up can hook into this in order to help make more useful cards from URLs that your Power-Up knows about.',"templates.app_management.categories":"Categories","templates.app_management.categories-description":"Choose up to two categories that describe your Power-Up. This helps users find your Power-Up in the directory.","templates.app_management.changelog":"Changelog","templates.app_management.claims-trello":"Claims Trello","templates.app_management.claims-trello-description":"When claiming attachments, some Power-Ups may claim attachments with <code>trello.com</code> URLs. To prevent Trello clients from rendering the attachments natively, the <code>Claims Trello</code> modifier is checked first. Enable Claims Trello if your Power-Up will claim <code>trello.com</code> attachments. <a>Read documentation here</a>","templates.app_management.client-id":"Client ID","templates.app_management.collaborator":"Collaborator","templates.app_management.collaborators":"Collaborators","templates.app_management.collaborators-description":"Collaborators are members of your Workspace who have permission to manage this app. Any collaborator or admin of this Workspace can add or remove other collaborators.","templates.app_management.collaborators-table.actions-header":"Actions","templates.app_management.collaborators-table.name-header":"Name","templates.app_management.collaborators-table.type-header":"Collaborator type","templates.app_management.community":"Community","templates.app_management.community-projects":"Community projects","templates.app_management.compliance-api-access":"Compliance API access","templates.app_management.compliance-api-add-oauth2":"<a>Add a confidential OAuth 2.0 client</a> to your app, then return here to register your intent to store user personal data.","templates.app_management.compliance-api-description":"If your app stores personal data, you are required to poll the Trello compliance API. A <a>confidential OAuth 2.0 client</a> or Trello Auth API key is needed to access the compliance API.","templates.app_management.compliance-api-learn-more":"Learn more about compliance requirements","templates.app_management.compliance-api-public-oauth2-warning":"Your public OAuth 2.0 client cannot poll the compliance API. You should always use a <a>confidential client</a> to store user data in a secure backend.","templates.app_management.compliance-api-ready-api-key":"Your app can poll the compliance API with its Trello Auth API key.","templates.app_management.compliance-api-ready-both":"Your app can poll the compliance API with OAuth 2.0 or its Trello Auth API key.","templates.app_management.compliance-api-ready-oauth2":"Your app can poll the compliance API with OAuth 2.0.","templates.app_management.configure":"Configure","templates.app_management.configure-oauth-2-0":"Configure OAuth 2.0","templates.app_management.configure-trello-auth":"Configure Trello Auth","templates.app_management.content":"Content","templates.app_management.content-editor-label":"Content area, start typing to enter text.","templates.app_management.continue":"Continue","templates.app_management.copied":"Copied","templates.app_management.copied-to-clipboard":"Copied to clipboard","templates.app_management.copy":"Copy","templates.app_management.copy-field-aria-label":"Copy {label}","templates.app_management.copy-to-clipboard":"Copy to clipboard","templates.app_management.create":"Create","templates.app_management.delete":"Delete","templates.app_management.delete-allowed-origin":"Delete allowed origin","templates.app_management.delete-allowed-origin-aria-label":"Delete allowed origin {origin}","templates.app_management.delete-app":"Delete app","templates.app_management.delete-callback-url":"Delete callback URL","templates.app_management.delete-warning":"Deleting this app cannot be undone.","templates.app_management.description":"Description","templates.app_management.description-editor-label":"Description area, start typing to enter text.","templates.app_management.developer-community-forums":"Developer Community Forums","templates.app_management.developer-terms":"Developer Terms","templates.app_management.distribution":"Distribution","templates.app_management.documentation":"Documentation","templates.app_management.documentation-for-oauth-2-0":"Documentation for OAuth 2.0","templates.app_management.documentation-for-trello-auth":"Documentation for Trello Auth","templates.app_management.each-power-up-can-have-a-unique-api-key-managed-here-by-collaborators":"Each Power-Up can have a unique API key managed here by collaborators.","templates.app_management.email":"Email","templates.app_management.email-description":"An email we can use to reach you regarding this app.","templates.app_management.email-placeholder":"me@company.com","templates.app_management.enter-existing-api-key":"Enter existing API key","templates.app_management.enter-the-name-of-this-app":"Enter the name of this app.","templates.app_management.error-api-key-is-required":"API key required if your Power-Up stores personal data.","templates.app_management.error-author-length":"Author name must be {max} characters or less.","templates.app_management.error-invalid-api-key":"This is not a valid API key.","templates.app_management.error-invalid-email":"This is not a valid email address.","templates.app_management.error-invalid-email-or-url":"This is not a valid email address or URL.","templates.app_management.error-invalid-url":"This is not valid URL.","templates.app_management.error-must-be-characters-long":"Must be {min} - {max} characters long.","templates.app_management.error-url-must-be-served-over-https":"This URL must be served over https.","templates.app_management.for-industry-standard-security-and-modern-token-governance-we-recommend-configuring-oauth-2-0-instead":"For industry-standard security and modern token governance, we recommend configuring <b>OAuth 2.0</b> instead.","templates.app_management.format-url":"Format URL","templates.app_management.format-url-description":"In card descriptions and comments, there may be URLs that your Power-Up could make look a lot better and more readable. With this capability you will be provided the URLs and can tell Trello when you have something better to be displayed.","templates.app_management.fourteen-to-update-api-key":"You’ll have 14 days to update your API keys anywhere they are used to ensure your Power-Up remains in compliance.","templates.app_management.generate-a-new-api-key":"Generate a new API key","templates.app_management.generate-a-new-trello-auth-api-key":"Generate a new Trello Auth API key for this app","templates.app_management.generate-api-key":"Generate API key","templates.app_management.generating-a-unique-api-key":"Generating a unique API key will replace the API key used for <a>Personal Data Storage and GDPR compliance.</a>","templates.app_management.getting-started":"Getting started","templates.app_management.icon":"Icon","templates.app_management.icon-description":"144px by 144px, must be served over <code>https</code>.","templates.app_management.iframe-connector-url":"Iframe connector URL","templates.app_management.iframe-connector-url-description":"Used to point to a HTML page that Trello will load onto the page as a hidden iframe and then Trello will use it to communicate with your Power-Up. Must be served over <code>https</code>. <a>Read more about iframe connector URLs and capabilities here.</a>","templates.app_management.introducing-oauth-2-0":"Introducing OAuth 2.0","templates.app_management.language":"Language","templates.app_management.language-description":"Localize your <a>listing</a> to ensure Trello users from all around the world can learn about your app.","templates.app_management.learn-more":"Learn more…","templates.app_management.learn-more-about":"Learn more about {capability}","templates.app_management.learn-more-about-oauth-2-0":"Learn more about OAuth 2.0","templates.app_management.learn-more-link":"Learn more","templates.app_management.leave":"Leave","templates.app_management.list-actions":"List actions","templates.app_management.list-actions-description":"Add new action options into the <code>...</code> menu on Trello lists.","templates.app_management.list-sorters":"List sorters","templates.app_management.list-sorters-description":'Add new sort options into the <code>...</code> → "Sort by" menu on Trello lists.',"templates.app_management.listings":"Listings","templates.app_management.manage-your-api-key":"Manage your API key","templates.app_management.metrics":"Metrics","templates.app_management.my-app-doesnt-use-power-up-capabilities":"My app doesn't use Power-up capabilities","templates.app_management.my-app-will-use-power-up-capabilities":"My app will use Power-up capabilities","templates.app_management.name":"Name","templates.app_management.name-description":"This will be used as the name of the app in the Power-Up directory, board menus, and elsewhere that Trello displays your app name to a user.","templates.app_management.new":"New","templates.app_management.new-app":"New App","templates.app_management.no":"No","templates.app_management.no-members":"No members available.","templates.app_management.no-power-ups":"Looks like you’ve not built an awesome, custom Power-Up yet! Not sure where to get started? Don’t worry, we’ve got you covered. Head on over to our <a>Power-Up developer documentation</a> to get started!","templates.app_management.no-teams":"Looks like you're not a member of a Trello Workspace. Once you join a Workspace, you'll be able to create Power-Ups for that Workspace, or manage existing ones.","templates.app_management.not-a-valid-api-key":"Invalid API key.","templates.app_management.oauth-2-0":"OAuth 2.0","templates.app_management.oauth-2-0-description":"More secure protocol for authorizing users and accessing the Trello API.","templates.app_management.oauth-2-getting-started":"To get started, add an OAuth 2.0 client to your app.","templates.app_management.oauth-2-introduction":"Trello's newest and most secure API authorization system.","templates.app_management.oauth2-announcement-app-page-description":"Switch to scoped access to give your users better security and control.","templates.app_management.oauth2-announcement-app-page-title":"Upgrade this app to OAuth 2.0","templates.app_management.oauth2-announcement-description":"Use scoped access and short-lived tokens to improve integration security.","templates.app_management.oauth2-announcement-dismiss":"Dismiss","templates.app_management.oauth2-announcement-enterprise-admin-description":"Manage app access with short-lived, revocable tokens for your enterprise.","templates.app_management.oauth2-announcement-enterprise-admin-title":"New OAuth 2.0 security controls","templates.app_management.oauth2-announcement-get-started":"Get started","templates.app_management.oauth2-announcement-set-up-oauth2-0":"Set up OAuth 2.0","templates.app_management.oauth2-announcement-title":"Build more secure apps with OAuth 2.0","templates.app_management.oauth2-announcement-view-oauth-2-0":"View OAuth 2.0","templates.app_management.oauth2-callback-url-warning":"Add a callback URL to use OAuth 2.0 with this app","templates.app_management.oauth2-client-create-error-description":"Something went wrong adding an OAuth 2.0 client to your app. Please try again later.","templates.app_management.oauth2-client-create-error-title":"OAuth 2.0 client wasn't added to your app.","templates.app_management.oauth2-client-security-type":"Client security type","templates.app_management.oauth2-client-security-type-confidential":"Confidential","templates.app_management.oauth2-client-security-type-public":"Public","templates.app_management.oauth2-continue-editing":"Cancel","templates.app_management.oauth2-discard-changes":"Discard","templates.app_management.oauth2-ready-message":"App is ready to use OAuth 2.0","templates.app_management.oauth2-scope-workspace-restriction-note":"Power-Up OAuth 2.0 clients are workspace-restricted. Your Power-Up will need to request authorization in each of the user's workspaces when this scope is requested.","templates.app_management.oauth2-settings-not-saved-warning":"You have unsaved changes to your app's OAuth 2.0 settings.","templates.app_management.oauth2-settings-update-error-description":"Something went wrong. Try saving again.","templates.app_management.oauth2-settings-update-error-title":"Your App's OAuth 2.0 settings weren't saved.","templates.app_management.oauth2-settings-updated-description":"All changes have been saved. You can now use your app with the new settings.","templates.app_management.oauth2-settings-updated-title":"Your App's OAuth 2.0 settings have been updated.","templates.app_management.oauth2-unsaved-changes-dialog-message":"You have unsaved changes to your app's OAuth 2.0 settings. These changes will be lost unless you save them.","templates.app_management.oauth2-unsaved-changes-dialog-title":"Discard changes?","templates.app_management.on-disable":"On disable","templates.app_management.on-disable-description":"Use this capability to run some code, perhaps to update your records or clean up, when a user disables your Power-Up on a board via the UI.","templates.app_management.on-enable":"On enable","templates.app_management.on-enable-description":"If you want your users to know how to use your Power-Up, you should use the <code>on-enable</code> capability. This capability gets triggered when a user enables your Power-Up.","templates.app_management.or":"or","templates.app_management.overview":"Overview","templates.app_management.overview-description":"Add a short one line overview to promote your app.","templates.app_management.please-contact-us-to-delete":"Please contact us at https://go.trello.com/dev-support to delete this Power-Up.","templates.app_management.please-enter-valid-url":"Please enter a valid URL. Callback URL must use https or localhost.","templates.app_management.please-keep-your-api-secret-safe":"Please keep your API Secret safe. Because your API Key is public for any client-side applications, we do not currently offer a way to reset it.","templates.app_management.power-up-guidelines":"Power-Up guidelines","templates.app_management.power-ups":"Power-Ups","templates.app_management.power-ups-can-add-or-modify-trello-ui":"Power-ups can add or modify the Trello UI.","templates.app_management.primary":"Primary","templates.app_management.privacy-and-compliance":"Privacy and compliance","templates.app_management.privacy-url":"Privacy URL","templates.app_management.privacy-url-description":"A link to your privacy policy. Check out <a>Trello's Privacy Policy</a> for inspiration.","templates.app_management.public-delete-warning":"This Power-Up is publicly listed on the Power-Up directory. Please communicate any plans to deprecate it to your users, and be prepared to respond to questions and support requests after deleting it.","templates.app_management.rate-limits":"Rate limits","templates.app_management.read-and-agree-to-the-terms":"We're glad you're here! To create new Power-Ups, we require that you have read and agreed to the <a>Trello Developer Terms</a>.","templates.app_management.read:board:trello-description":"Read cards, lists, and comments in boards.","templates.app_management.read:board:trello-name":"Read boards","templates.app_management.read:enterprise:trello-description":"Read enterprises.","templates.app_management.read:enterprise:trello-name":"Read enterprises","templates.app_management.read:member.inbox:trello-description":"Read inbox.","templates.app_management.read:member.inbox:trello-name":"Read inbox","templates.app_management.read:member.planner:trello-description":"Read planner.","templates.app_management.read:member.planner:trello-name":"Read planner","templates.app_management.read:member:trello-description":"Read email address, public name, public avatar, and memberships of boards, workspaces, and enterprises.","templates.app_management.read:member:trello-name":"Read members","templates.app_management.read:organization:trello-description":"Read workspaces.","templates.app_management.read:organization:trello-name":"Read workspaces","templates.app_management.reference":"Reference","templates.app_management.register-api-key":"Register API key","templates.app_management.remove":"Remove","templates.app_management.remove-data":"Remove data","templates.app_management.remove-data-description":'This capability allows you to also perform an action when the user clicks "Remove personal settings".',"templates.app_management.required-fields-hint":"* denotes mandatory fields","templates.app_management.rest-api":"REST API","templates.app_management.rotate-secret":"Rotate secret","templates.app_management.rotate-secret-confirm-message":"Are you sure you want to rotate your app's OAuth 2.0 client secret? You will no longer be able to use the old client secret in the OAuth 2.0 authorization flow.","templates.app_management.rotate-secret-confirm-title":"Rotate client secret?","templates.app_management.rotate-secret-error-description":"Something went wrong. Try rotating again.","templates.app_management.rotate-secret-error-title":"Your app's OAuth 2.0 secret couldn't be rotated.","templates.app_management.rotating-secret":"Rotating secret","templates.app_management.sample-auth-url":"Sample Auth URL","templates.app_management.save":"Save","templates.app_management.save-attachment":"Save attachment","templates.app_management.save-attachment-description":'This capability will add a "Save to {pluginName}" button to Trello file attachments, letting users know they can save their attachment to your platform.',"templates.app_management.search-members":"Search by name or username","templates.app_management.secondary":"Secondary","templates.app_management.secret":"Secret","templates.app_management.select-workspace":"Select...","templates.app_management.share-feedback":"Share feedback","templates.app_management.share-this-button-with-your-users":"Share this button with your users to have them enable this Power-Up on their boards.","templates.app_management.share-your-thoughts-on-oauth-2":"Share your thoughts on OAuth 2.0","templates.app_management.share-your-thoughts-on-power-up-updates":"Share your thoughts on Power-Up Updates","templates.app_management.show-authorization":"Show authorization","templates.app_management.show-authorization-description":"This capability allows you to perform an action when user clicks on the Authorize account prompt.","templates.app_management.show-settings":"Show settings","templates.app_management.show-settings-description":'If your Power-Up has a settings or configuration page, supporting this capability will show the gear button in your Power-Up, and provide the "Edit Power-Up settings" prompt. When that prompt is clicked Trello will run your capability function.',"templates.app_management.side-navigation":"Side navigation","templates.app_management.something-went-wrong":"Something went wrong. Please try again later.","templates.app_management.stores-personal-data":"Does your Power-Up store any Trello user personal data?","templates.app_management.stores-personal-data-description":"Personal data is any data that can be used directly or indirectly to identify a user such as a Trello user’s avatar, email, username, full name, bio, and locale.","templates.app_management.stores-personal-data-information":"Power-Ups that store personal data outside of Trello have extra requirements. <a>Learn more</a> about personal data storage requirements and best practices.","templates.app_management.support-email":"Support contact","templates.app_management.support-email-description":"An email or support link that users can use to reach your support team.","templates.app_management.support-email-placeholder":"support@company.com","templates.app_management.supported":"Supported","templates.app_management.team":"Workspace","templates.app_management.team-description":"Your app belongs to this Workspace. Admins of this Workspace and the app's collaborators will be able to manage this app. If you leave the Workspace, you will no longer be able to manage this app.","templates.app_management.the-number-of-boards-usage":"The number of boards using {name}.","templates.app_management.this-cannot-be-modified-after-app-creation":"This cannot be modified after app creation.","templates.app_management.title":"Title","templates.app_management.title-description":"This will be used as the header of your Power-Up update in the Power-Up directory.","templates.app_management.to-delete-this-app":"To delete this app, enter <b>{pluginName}</b> and click the Delete button below.","templates.app_management.to-get-started-generate-a-new-api-key":"To get started, generate a new API key.","templates.app_management.trello-auth":"Trello Auth","templates.app_management.trello-auth-description":"Protocol for accessing Trello API.","templates.app_management.unauthorized-api-key":"Invalid API key. Follow the link above to get your existing API key.","templates.app_management.unsaved-changes-prompt-cancel":"Cancel","templates.app_management.unsaved-changes-prompt-discard":"Discard","templates.app_management.unsaved-changes-prompt-message":"You have unsaved changes. These changes will be lost unless you save them.","templates.app_management.unsaved-changes-prompt-title":"Discard changes?","templates.app_management.unsupported":"Unsupported","templates.app_management.untitled":"Untitled","templates.app_management.update-language-description":"Localize your <a>update</a> to ensure Trello users from all around the world can learn about your app.","templates.app_management.updates":"Updates","templates.app_management.updates-you-create-will-appear-here":"Updates you create will appear here.","templates.app_management.use-exis