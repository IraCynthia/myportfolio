.DTfoHBHS2AB07W {
  z-index: 1;
  box-sizing: border-box;
  border-radius: var(--ds-radius-small, 4px);
  background-color: var(--ds-surface-overlay, #fff);
  width: 100%;
  box-shadow: var(--ds-shadow-overlay, 0px 8px 12px #091e4226, 0px 0px 1px #091e424f);
  pointer-events: none;
